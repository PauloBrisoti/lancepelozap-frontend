# ============================================================
# .env.example — SaaS Gestão Modular — Frontend
# Copie para .env e preencha com os valores reais
# ============================================================

# URL da API backend (deixe vazio para mesma origem via nginx proxy)
# Em dev local com backend na porta 3001:
# VITE_API_URL=http://localhost:3001/api
# Em produção com nginx reverso (recomendado):
# VITE_API_URL=
VITE_API_URL=http://localhost:3001/api
